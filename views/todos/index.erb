<h1>Todo</h1>

<ul class="items">
  <% @todos.each do |todo| %>
    <li class="item">
      <a href="/todos/<%= todo['id'] %>">
        <h2><%= todo['name'] %></h2>
      </a>

      <p><%= todo['description'] %></p>

      <form action="/todos/<%= todo['id'] %>/delete", method="POST">
        <input type="submit" value="Ta bort">
      </form>
      <form action="/todos/<%= todo['id'] %>/update" method="POST">
        <input type="hidden" name="name" value="<%= todo['name'] %>">
        <input type="hidden" name="desciprion" value="<%= todo['description'] %>">
        <input type="hidden" name="status" value="1">
        <input type="submit" value="Klar">
      </form>
    </li>
  <% end %>
</ul>

<h1>Färdiga</h1>

<ul class="items">
  <% @done.each do |todo| %>
    <li class="item">
      <a href="/todos/<%= todo['id'] %>">
        <h2><%= todo['name'] %></h2>
      </a>

      <p><%= todo['description'] %></p>

      <form action="/todos/<%= todo['id'] %>/delete", method="POST">
        <input type="submit" value="Ta bort">
      </form>
      <form action="/todos/<%= todo['id'] %>/update" method="POST">
        <input type="hidden" name="name" value="<%= todo['name'] %>">
        <input type="hidden" name="desciprion" value="<%= todo['description'] %>">
        <input type="hidden" name="status" value="0">
        <input type="submit" value="Inte Klar">
      </form>
    </li>
  <% end %>
</ul>
